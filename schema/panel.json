  "properties": {
    "toolbar": {
      "title": "Notebook panel toolbar items",
      "description": "Note: To disable a toolbar item,\ncopy it to User Preferences and add the\n\"disabled\" key. The following example will disable the Interrupt button item:\n{\n  \"toolbar\": [\n    {\n      \"name\": \"interrupt\",\n      \"disabled\": true\n    }\n  ]\n}\n\nToolbar description:",
      "items": {
        "$ref": "#/definitions/toolbarItem"
      },
      "type": "array",
      "default": []
    }
  },
  "additionalProperties": false,
  "type": "object",
  "definitions": {
    "toolbarItem": {
      "properties": {
        "name": {
          "title": "Unique name",
          "type": "string"
        },
        "icon": {
          "title": "Item icon id",
          "description": "If defined, it will override the command icon",
          "type": "string"
        },
        "label": {
          "title": "Item label",
          "description": "If defined, it will override the command label",
          "type": "string"
        },
        "caption": {
          "title": "Item caption",
          "description": "If defined, it will override the command caption",
          "type": "string"
        },
        "type": {
          "title": "Item type",
          "type": "string",
          "enum": ["command", "spacer", "label", "dropdown"]
        },
        "rank": {
          "title": "Item rank",
          "type": "number",
          "minimum": 0,
          "default": 50
        },
        "disabled": {
          "title": "disable item",
          "type": "boolean",
          "default": false
        },
        "command": {
          "title": "Command id",
          "type": "string",
          "default": ""
        },
        "args": {
          "title": "Command arguments",
          "type": "object"
        },
        "dropdownItems": {
          "title": "Dropdown commands",
          "items": {
            "$ref": "#/definitions/toolbarDropdownItem"
          },
          "type": "array",
          "default": []
        },
        "openToLeft": {
          "title": "Open the dropdown menu to the left of the toggle button",
          "type": "boolean",
          "default": false
        }
      },
      "required": ["name"],
      "additionalProperties": false,
      "type": "object"
    },
    "toolbarDropdownItem": {
      "oneOf": [
        {
          "$ref": "#/definitions/toolbarDropdownCommandItem",
          "title": "Command Button"
        },
        {
          "$ref": "#/definitions/toolbarDropdownSpacerItem",
          "title": "Spacer"
        }
      ],
      "type": "object"
    },
    "toolbarDropdownCommandItem": {
      "properties": {
        "name": {
          "title": "Unique name",
          "type": "string"
        },
        "icon": {
          "title": "Item icon id",
          "description": "If defined, it will override the command icon",
          "type": "string"
        },
        "label": {
          "title": "Item label",
          "description": "If defined, it will override the command label",
          "type": "string"
        },
        "caption": {
          "title": "Item caption",
          "description": "If defined, it will override the command caption",
          "type": "string"
        },
        "type": {
          "title": "Item type",
          "type": "string",
          "enum": ["command"],
          "default": "command"
        },
        "rank": {
          "title": "Item rank",
          "type": "number",
          "minimum": 0,
          "default": 50
        },
        "disabled": {
          "title": "hide item",
          "type": "boolean",
          "default": false
        },
        "command": {
          "title": "Command id",
          "type": "string",
          "default": ""
        },
        "args": {
          "title": "Command arguments",
          "type": "object"
        }
      },
      "required": ["name", "type"],
      "additionalProperties": false,
      "type": "object"
    },
    "toolbarDropdownSpacerItem": {
      "properties": {
        "name": {
          "title": "Unique name",
          "type": "string"
        },
        "type": {
          "title": "Item type",
          "type": "string",
          "enum": ["spacer"],
          "default": "spacer"
        },
        "rank": {
          "title": "Item rank",
          "type": "number",
          "minimum": 0,
          "default": 50
        },
        "disabled": {
          "title": "hide item",
          "type": "boolean",
          "default": false
        }
      },
      "required": ["name", "type"],
      "additionalProperties": false,
      "type": "object"
    }
  }
